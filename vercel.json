{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' https://us.posthog.com; base-uri 'self'; object-src 'none'; form-action 'none'" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/c/01", "permanent": false },
    { "source": "/c", "destination": "/c/01", "permanent": false },
    { "source": "/rsvp", "destination": "/c/01?go=rsvp", "permanent": false },
    { "source": "/qr", "destination": "/c/01?src=qr", "permanent": false },
    { "source": "/ig", "destination": "/c/01?src=ig", "permanent": false },
    { "source": "/tt", "destination": "/c/01?src=tt", "permanent": false },
    { "source": "/invite", "destination": "/c/01?src=invite", "permanent": false },
    { "source": "/@:who", "destination": "/c/01?src=@:who", "permanent": false }
  ],
  "rewrites": [
    { "source": "/c/01", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/involved", "destination": "/involved.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
